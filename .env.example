# MemPABench environment. Copy this file to `.env` in the repository root and
# fill in the empty values:
#
#   cp .env.example .env
#
# The harness loads `.env` from the repository root; the memory-service compose
# files read it through `docker compose --env-file .env`. `.env` is gitignored:
# never commit it. Lines starting with `# NAME=` are optional and show the value
# the code uses when the variable is unset.

# ---------------------------------------------------------------------------
# Required for every run
# ---------------------------------------------------------------------------

# OpenRouter key for the PA, the simulated user and the offline judge.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Live simulator judge (official setting: on)
# Reviews every simulated-user message during a session, as in the paper.
# It calls the endpoint directly and ignores HTTP_PROXY / HTTPS_PROXY.
# ---------------------------------------------------------------------------

# `live` turns the judge on (official); `off` skips it and the run no longer follows the paper protocol.
MEMPA_JUDGE=live
# Display name of judge endpoint 1; it appears in the run's judge_call records.
MEMPA_JUDGE_NAME_1=openrouter
# Base URL of judge endpoint 1.
MEMPA_JUDGE_URL_1=https://openrouter.ai/api/v1
# Key for judge endpoint 1: your OpenRouter key again (each endpoint carries its own key).
MEMPA_JUDGE_API_KEY_1=
# Model of judge endpoint 1 (official: Gemma-4-31B through OpenRouter).
MEMPA_JUDGE_MODEL_1=google/gemma-4-31b-it
# Share of sessions bound to endpoint 1; with a single endpoint any positive value works.
MEMPA_JUDGE_WEIGHT_1=1
# Endpoint tried first in every session (1 = the entry above).
MEMPA_JUDGE_PRIMARY=1
# Retries on one endpoint (429, 5xx, dropped connection) before the call fails.
MEMPA_JUDGE_RETRIES=3
# Wall-clock deadline per judge call, in seconds.
# MEMPA_JUDGE_DEADLINE_S=60
# Judge question groups one candidate simulator message may spend.
# MEMPA_JUDGE_TURN_BUDGET=14
# Model for a numbered endpoint that sets no MEMPA_JUDGE_MODEL_<n> of its own.
# MEMPA_JUDGE_MODEL=gemma-4-12b-it
# Leave the next three unset: a single MEMPA_JUDGE_URL pins every session to one
# box and replaces the numbered endpoint above, and then needs its own key and a
# MEMPA_JUDGE_PIN reason.
# MEMPA_JUDGE_URL=
# MEMPA_JUDGE_API_KEY=
# MEMPA_JUDGE_PIN=

# ---------------------------------------------------------------------------
# Embeddings: needed by mem0, simple_rag and memos
# (text-embedding-3-small through an OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------

# Key used only for embeddings; it is not shared with the PA or memory-side models.
OPENAI_EMB_API_KEY=
# Embedding endpoint (also passed to the MemOS container).
# OPENAI_EMB_API_BASE=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# mem0 and simple_rag: Qdrant from deploy/mem0/compose.yaml
# ---------------------------------------------------------------------------

# Qdrant host the harness connects to; recorded in run_plan.yaml at plan time.
QDRANT_HOST=127.0.0.1
# Qdrant HTTP port the harness connects to; keep it equal to MEM0_QDRANT_HTTP_PORT.
QDRANT_PORT=6333
# Absolute path of a lock file shared by every run that restores checkpoints on this Qdrant.
MEMPA_QDRANT_RESTORE_LOCK_PATH=
# Host ports the mem0 compose file publishes on 127.0.0.1.
# MEM0_QDRANT_HTTP_PORT=6333
# MEM0_QDRANT_GRPC_PORT=6334

# ---------------------------------------------------------------------------
# memos: the MemOS service from deploy/memos/compose.yaml
# ---------------------------------------------------------------------------

# MemOS API the harness talks to (the compose file publishes it on MEMOS_HOST_PORT).
MEMOS_API_BASE=http://127.0.0.1:8100
# MemOS API container the harness reads usage records from with `docker exec`; set it only when that container runs under another name.
# MEMOS_CONTAINER_NAME=mempa-memos-api
# Provider of the MemOS memory LLM; the harness accepts only openrouter.
MEMOS_MEMORY_LM_PROVIDER_NAME=openrouter
# MemOS memory LLM (paper: openai/gpt-5.5); pass the same id to `--memory-side-model`.
MEMOS_MEMORY_LM_MODEL=openai/gpt-5.5
# Endpoint of the MemOS memory LLM; the harness accepts only the standard OpenRouter endpoint.
MEMOS_MEMORY_LM_API_BASE=https://openrouter.ai/api/v1
# Key of the MemOS memory LLM: your OpenRouter key.
MEMOS_MEMORY_LM_API_KEY=
# Whether the memory LLM requires provider task affinity (paper: false).
MEMOS_MEMORY_LM_TASK_AFFINITY_REQUIRED=false
# Task-affinity namespace; leave empty when affinity is not required.
MEMOS_MEMORY_LM_TASK_AFFINITY_NAMESPACE=
# Password of the MemOS Neo4j container; choose one.
MEMOS_NEO4J_PASSWORD=
# Host ports the memos compose file publishes on 127.0.0.1.
# MEMOS_HOST_PORT=8100
# MEMOS_NEO4J_HTTP_PORT=7574
# MEMOS_NEO4J_BOLT_PORT=7787
# MEMOS_QDRANT_HTTP_PORT=6433
# MEMOS_QDRANT_GRPC_PORT=6434

# ---------------------------------------------------------------------------
# Where runs go, and run settings
# ---------------------------------------------------------------------------

# Root of all run directories (relative paths resolve against the repository); keep it inside the workspace below.
# MEMPA_RUNS_ROOT=workspace/runs
# Absolute path of the workspace that holds the producer locks and probe-repeat state (default: <repository>/workspace).
# MEMPA_WORKSPACE_ROOT=/absolute/path/to/mempabench/workspace
# Run settings file (failure policy, probe attempts, repeat rounds, budgets).
# MEMPA_RUN_CONFIG=configs/run_config.yaml

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------

# Deadline per PA and simulated-user request, in seconds (unset: 600 for a PA or
# File memory consolidation request, 180 for a simulated-user request).
# MEMPA_LLM_REQUEST_TIMEOUT_S=600
# Concurrent model requests per PA process (0 or less = unlimited).
# NANOBOT_MAX_CONCURRENT_REQUESTS=3
